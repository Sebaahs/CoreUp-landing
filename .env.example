# Variables de build de la landing (Vite). Copiá este archivo a .env.local para desarrollo.
# Son públicas (terminan en el JS que baja el navegador): nada de secretos acá.

# Backend (ToolboxBackend) para POST /public/signup, sin barra final.
# Local: el back en :3000 o el mock (`npm run mock`). El origen de la landing
# tiene que estar en ALLOWED_ORIGINS del backend (en local, http://localhost:5173).
VITE_API_URL=http://localhost:3000

# Site key de Cloudflare Turnstile. La de abajo es la de prueba de Cloudflare (siempre pasa).
# Vacía = no se carga el widget y el token viaja vacío (solo sirve con TURNSTILE_BYPASS=true en el back).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Versión de los Términos que acepta el usuario. Tiene que ser igual a TERMS_VERSION del backend,
# si no el alta da VAL-400.
VITE_TERMS_VERSION=2026-10-borrador

# Toolbox, para el link "Iniciá sesión" (y el de DUP-409). Local: el front de Toolbox en dev.
VITE_TOOLBOX_URL=http://localhost:8080
